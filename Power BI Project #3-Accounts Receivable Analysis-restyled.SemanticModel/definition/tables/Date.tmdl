	hierarchy 'Date Hierarchy'
		lineageTag: 0348aa47-9db2-4411-b3fc-ed8fd29c3206

		level Year
			lineageTag: e0057ee6-5b52-4a88-a57c-fc6a3eaf8043
			column: Year

		level Quarter
			lineageTag: ca33aa7b-3a8e-41ed-8297-aff4d10cfa3c
