		level Day
			lineageTag: bb3cb56a-47b2-48ee-8e36-b43b20bbc474
			column: Day

	partition Date = calculated
		mode: import
		source =
				VAR _Dates =
				    UNION (
				        SELECTCOLUMNS ( 'Entity Name (Data)', "d", 'Entity Name (Data)'[Estimated Bill Date] ),
				        SELECTCOLUMNS ( 'Entity Name (Data)', "d", 'Entity Name (Data)'[Invoice Date] ),
				        SELECTCOLUMNS ( 'Entity Name (Data)', "d", 'Entity Name (Data)'[Credit Note Date] ),
				        SELECTCOLUMNS ( 'Entity Name (Data)', "d", 'Entity Name (Data)'[Receipt Date] )
				    )
				RETURN
				    CALENDAR (
				        DATE ( YEAR ( MINX ( _Dates, [d] ) ), 1, 1 ),
				        DATE ( YEAR ( MAXX ( _Dates, [d] ) ), 12, 31 )
				    )

