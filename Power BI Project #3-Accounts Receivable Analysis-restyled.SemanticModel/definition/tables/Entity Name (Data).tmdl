	column 'Payment Days'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 152882f5-ab48-48f3-a60d-e923bddb6988
		summarizeBy: none
		sourceColumn: Payment Days after Invoice

		annotation SummarizationSetBy = Automatic

	column 'Overdue Days' = ```
			
			VAR DueDate = 'Entity Name (Data)'[Invoice Date] + 'Entity Name (Data)'[Payment Days]
			
			VAR AdjustedDate = 
			    IF(
			        NOT(ISBLANK('Entity Name (Data)'[Receipt Date])), 
			        'Entity Name (Data)'[Receipt Date], 
			        IF(
			            NOT(ISBLANK('Entity Name (Data)'[Credit Note Date])), 
			            'Entity Name (Data)'[Credit Note Date], 
			            TODAY()
			        )
			    )
			
			RETURN 
			IF(
			    OR(
			        ISBLANK('Entity Name (Data)'[Invoice Date]), 
			        ISBLANK('Entity Name (Data)'[Invoice Number])
			    ), 
			    BLANK(), 
			    DATEDIFF(DueDate, AdjustedDate, DAY)
			)
			    
			
			```
		isHidden
		formatString: 0
		lineageTag: 41c4b403-5484-4dd1-8c28-5e2e62513b21
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Aging Bucket' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK('Entity Name (Data)'[Overdue Days]), "No Due Date",
			     'Entity Name (Data)'[Overdue Days] <= 0, "On Time",
			    'Entity Name (Data)'[Overdue Days]  <= 30, "1-30 Days Late",
			     'Entity Name (Data)'[Overdue Days]  <= 60, "31-60 Days Late",
			    'Entity Name (Data)'[Overdue Days]  <= 90, "61-90 Days Late",
			    'Entity Name (Data)'[Overdue Days]  <= 180, "91-180 Days Late",
			     'Entity Name (Data)'[Overdue Days]  <= 365, "181-365 Days Late",
			     'Entity Name (Data)'[Overdue Days]  > 365, "Above 1 Year Late"
			)
		isHidden
		lineageTag: 0269db4a-1cb9-412e-aa6c-b3daac3918e3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Entity Name'
		dataType: string
		isHidden
		lineageTag: 06336e2a-03ab-4ea2-9ec2-dcff9ca2f6bd
		summarizeBy: none
		sourceColumn: Entity Name

		annotation SummarizationSetBy = Automatic

	column 'Billing Delay Days' = ```
			IF (
			    ISBLANK ( 'Entity Name (Data)'[Invoice Date] ),
			    BLANK (),
			    DATEDIFF ( 'Entity Name (Data)'[Estimated Bill Date], 'Entity Name (Data)'[Invoice Date], DAY )
			)
			```
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 919be369-afb9-405e-b568-d9f010e591d1
		summarizeBy: none

	column 'Billing Timing' = ```
			VAR _Delay = 'Entity Name (Data)'[Billing Delay Days]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( 'Entity Name (Data)'[Invoice Date] ), "No Invoice",
			        ISBLANK ( _Delay ), "Unknown",
			        _Delay < 0, "Early",
			        _Delay = 0, "On Time",
			        "Delay"
			    )
			```
		dataType: string
		isHidden
		lineageTag: 39215964-96a5-44e1-a9a9-b731334c624a
		summarizeBy: none

	column 'Project Key' = ```
			'Entity Name (Data)'[Project Code] & "|" & 'Entity Name (Data)'[Project MD] & "|" & 'Entity Name (Data)'[Project Department]
			```
		dataType: string
		isHidden
		lineageTag: ce5ca97f-dd07-46c1-8b96-dd8c86a42e5d
		summarizeBy: none

