model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Entity Name (Data)","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Entity Name (Data)'
ref table _Measures
ref table Date
ref table 'Metric'
ref table Aging
ref table Project
ref table 'Billing Timing'
ref table Client

